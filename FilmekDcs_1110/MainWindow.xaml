<Window x:Class="FilmekDcs_1110.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FilmekDcs_1110"
        mc:Ignorable="d"
        Title="Filmek" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        
        <StackPanel Orientation="Vertical" Grid.Column="0">
            <Button Width="200" Margin="5" Content="Filmek betölrése" Click="filmekbetoltese"/>
            <Button Width="200" Margin="5" Content="Hány film van?" Click="hanyfilmvan"/>
            <Button Width="200" Margin="5" Content="Leghoszabb film?" Click="leghoszabbfilm"/>
            <Button Width="200" Margin="5" Content="Átlag értékelés" Click="atlagertekeles" />
            <Button Width="200" Margin="5" Content="Csak Sci-fi" Click="csakscifi"/>
            <Button Width="200" Margin="5" Content="Csak címek" />
            <Button Width="200" Margin="5" Content="Renezés cím szerint" />
            <ProgressBar Width="200" Height="18" Margin="0,20,0,0" x:Name="prgbar"/>
        </StackPanel>

        <StackPanel Grid.Column="1">
            <DataGrid x:Name="datagrid" IsReadOnly="True" MaxHeight="200"/>
        </StackPanel>
    </Grid>
</Window>
